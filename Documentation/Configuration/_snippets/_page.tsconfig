# Clear the cache of the pages with the job board (UIDs 42 and 87) when a
# record in this folder is saved. Must be set for the storage folder.
TCEMAIN.clearCacheCmd = 42, 87

# Salary steps are maintained inline in their salary grade
mod.web_list.hideTables := addToList(tx_jobboard_domain_model_salarystep)

# Pre-fill the validity of new salary grades (example: year 2026)
TCAdefaults.tx_jobboard_domain_model_salarygrade {
  starttime = 1767225600
  endtime = 1798761599
}
