{
	"name": "jweiland/jobfair2",
	"type": "typo3-cms-extension",
	"description": "Job Board - Displays a searchable list of job openings with map view and optional automatic import from external sources",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"TYPO3 CMS",
		"jobfair",
		"jobfair2"
	],
	"homepage": "https://jweiland.net",
	"authors": [
		{
			"name": "Stefan Froemken",
			"email": "projects@jweiland.net",
			"role": "Lead Developer"
		}
	],
	"support": {
		"email": "projects@jweiland.net",
		"issues": "https://github.com/jweiland-net/jobfair2/issues",
		"source": "https://github.com/jweiland-net/jobfair2"
	},
	"require": {
		"ext-intl": "*",
		"typo3/cms-core": "^13.4",
		"jweiland/maps2": "*",
		"friendsoftypo3/tt-address": "*",
		"bithost-gmbh/pdfviewhelpers": "*"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.44",
		"typo3/coding-standards": "^0.8",
		"typo3/testing-framework": "^9.1.2"
	},
	"autoload": {
		"psr-4": {
			"JWeiland\\Jobfair2\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"JWeiland\\Jobfair2\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"app-dir": ".Build",
			"extension-key": "jobfair2",
			"web-dir": ".Build/web"
		}
	}
}
