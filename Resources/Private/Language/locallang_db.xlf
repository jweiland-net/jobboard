				<source>Is imported record?</source>
			</trans-unit>
			<trans-unit id="tx_jobfair2_domain_model_job.is_import.description">
				<source>Indicates, if this job was created manual in TYPO3 backend or was imported.</source>
			</trans-unit>
			<trans-unit id="tx_jobfair2_domain_model_job.vacancy_id">
				<source>Vacancy ID</source>
			</trans-unit>
