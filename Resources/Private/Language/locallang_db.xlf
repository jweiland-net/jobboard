		<body>
			<trans-unit id="plugin.jobfair.title">
				<source>Jobfair</source>
			</trans-unit>
			<trans-unit id="plugin.jobfair.description">
				<source>Integrates a job board with which visitors can reduce the job offers to their needs using various filters.</source>
			</trans-unit>

