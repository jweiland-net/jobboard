{
  "name": "jobboard-tailwind",
  "private": true,
  "description": "Builds Resources/Public/Css/jobboard.css for the default frontend templates of EXT:jobboard",
  "scripts": {
    "build": "tailwindcss --input jobboard.css --output ../../Resources/Public/Css/jobboard.css --minify",
    "watch": "tailwindcss --input jobboard.css --output ../../Resources/Public/Css/jobboard.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
