mod.wizards.newContentElement.wizardItems.plugins {
  elements {
    jobboard {
      iconIdentifier = ext-jobboard-record-job
      title = LLL:EXT:jobboard/Resources/Private/Language/locallang_db.xlf:plugin.jobboard.title
      description = LLL:EXT:jobboard/Resources/Private/Language/locallang_db.xlf:plugin.jobboard.description
      tt_content_defValues {
        CType = jobboard_jobboard
      }
    }
  }
}

# Add CType Preview
mod.web_layout.tt_content.preview.jobboard_jobboard = EXT:jobboard/Resources/Private/Templates/PluginPreview/Jobboard.html
