plugin.tx_jobfair2 {
  view {
    templateRootPaths {
      0 = EXT:jobfair2/Resources/Private/Templates/
      1 = {$jobfair2.templateRootPath}
      2 = EXT:maps2/Resources/Private/Templates/
    }
    partialRootPaths {
      0 = EXT:jobfair2/Resources/Private/Partials/
      1 = {$jobfair2.partialRootPath}
      2 = EXT:maps2/Resources/Private/Partials/
    }
    layoutRootPaths {
      0 = EXT:jobfair2/Resources/Private/Layouts/
      1 = {$jobfair2.layoutRootPath}
      2 = EXT:maps2/Resources/Private/Layouts/
    }
  }

  persistence {
    storagePid = {$jobfair2.storagePid}
    recursive = 3
  }

  settings {
    pidOfDetailPage = {$jobfair2.pidOfDetailPage}
    pidOfApplicationForm = {$jobfair2.pidOfApplicationForm}
  }
}

page.includeCSS {
  jqueryAutocomplete = EXT:jobfair2/Resources/Public/Css/jquery-ui.min.css
  jobfair2 = EXT:jobfair2/Resources/Public/Css/style.css
  drs = EXT:jw5160001drsportal/Resources/Public/Css/jobfair.css
  jobfair2pdf = EXT:jobfair2/Resources/Public/Css/pdf.css
}

page.includeJSFooter {
  jqueryAutocomplete = EXT:jobfair2/Resources/Public/JavaScript/jquery-ui.min.js
  dataTables = EXT:jobfair2/Resources/Public/JavaScript/dataTables.min.js
  cookiejs = EXT:jobfair2/Resources/Public/JavaScript/js.cookie-2.2.1.min.js
  jobfair2 = EXT:jobfair2/Resources/Public/JavaScript/script.js
}
