[request.getPageArguments()?.getPageType() == 1575903427]
config {
  disableAllHeaderCode = 1
  xhtml_cleaning = none
  admPanel = 0
  debug = 0
  disablePrefixComment = 1
  linkVars >
}

pageJobboardPDF = PAGE
pageJobboardPDF {
  typeNum = 1575903427
  10 < tt_content.jobboard_jobboard.20
}

plugin.tx_jobboard {
  view {
    templateRootPaths {
      100 = EXT:jobboard/Resources/Private/Pdf/
    }
  }
}

plugin.tx_pdfviewhelpers.settings {
  page {
    margin {
      top = 20
      right = 25
      bottom = 20
      left = 25
    }
  }
  header {
    posY = 10
  }
  footer {
    posY = -15
  }
  generalText {
    lineHeight = 1.5
  }
  text {
    padding {
      bottom = 2
    }
    types {
      teaser {
        fontStyle = bold
      }
      author-date {
        color = #888
      }
      media-description {
        color = #888
        paragraphSpacing = 0
        padding {
          top = 1
          bottom = 0
        }
      }
      footer {
        color = #888
      }
    }
  }
  headline {
    types {
      title {
        lineHeight = 1.2
        fontSize = 24
        padding {
          top = 0
          bottom = 6
        }
      }
    }
  }
  image {
    padding {
      bottom = 0
    }
  }
  html {
    styleSheet = EXT:jobboard/Resources/Public/Css/pdf.css
  }
}

module.tx_pdfviewhelpers < plugin.tx_pdfviewhelpers
[global]
